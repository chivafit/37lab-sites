{
  "name": "37lab-maps-leads",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Captura local de leads no Google Maps para o painel 37LAB",
  "bin": {
    "maps-leads": "./index.mjs"
  },
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "captar": "node index.mjs",
    "lote": "node index.mjs --lote buscas.json --supabase",
    "lote:csv": "node index.mjs --lote buscas.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "playwright": "1.56.1"
  }
}
